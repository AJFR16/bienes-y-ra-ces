<?xml version="1.0" encoding="utf-8"?>
<odoo>

   

    <record id="view_estate_property_tag_list" model="ir.ui.view">
        <field name="name">estate.property.tag.list</field>
        <field name="model">estate.property.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>
     <!-- View estate.property.type form -->
    <record id="estate_property_tag_action" model="ir.actions.act_window">
        <field name="name">Property Tags</field>
        <field name="res_model">estate.property.tag</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                define property tags here!
            </p>
            <p>
                there are many tags of properties (cozy, spacious, and so on).
            </p>
            <p>
                your property filtering and marketing can be easier with tags!
            </p>
        </field>
    </record>
</odoo>